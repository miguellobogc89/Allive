{
  "expo": {
    "name": "allive",
    "slug": "allive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icons/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allive necesita acceso a la cámara para emitir vídeo en directo.",
        "NSMicrophoneUsageDescription": "Allive necesita acceso al micrófono para emitir audio en directo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "bundleIdentifier": "com.miguel.lobogc.89.allive"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDR2IqA3fDnA3v6bKFp3TiCWjrXqTqgjCk"
        }
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.miguel.lobogc.x89.allive"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allive necesita acceso a la cámara para emitir vídeo en directo.",
          "microphonePermission": "Allive necesita acceso al micrófono para emitir audio en directo.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allive necesita acceso a tus fotos para elegir una imagen de perfil.",
          "cameraPermission": "Allive necesita acceso a la cámara para hacer una foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF3B30",
          "defaultChannel": "allive"
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "38caf8c4-1784-4aad-ae62-68ac32e64797"
      }
    }
  }
}
