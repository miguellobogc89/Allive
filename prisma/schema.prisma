generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                            String          @id @default(cuid())
  username                                      String          @unique
  displayName                                   String?
  avatarUrl                                     String?
  createdAt                                     DateTime        @default(now())
  updatedAt                                     DateTime        @updatedAt
  email                                         String          @unique
  password_hash                                 String
  live_comments                                 live_comments[]
  live_likes                                    live_likes[]
  liveSessions                                  LiveSession[]
  user_follows_user_follows_follower_idTousers  user_follows[]  @relation("user_follows_follower_idTousers")
  user_follows_user_follows_following_idTousers user_follows[]  @relation("user_follows_following_idTousers")

  @@map("users")
}

model LiveSession {
  id            String          @id @default(cuid())
  roomName      String          @unique
  creatorId     String
  status        LiveStatus      @default(LIVE)
  title         String?
  description   String?
  latitude      Float?
  longitude     Float?
  placeName     String?
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  eventName     String?
  thumbnailUrl  String?
  live_comments live_comments[]
  live_likes    live_likes[]
  creator       User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
  @@index([creatorId])
  @@index([eventName])
  @@map("live_sessions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model live_likes {
  id              String      @id
  live_session_id String
  user_id         String?
  guest_id        String?
  created_at      DateTime    @default(now())
  live_sessions   LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           User?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([live_session_id, guest_id], map: "live_likes_live_session_guest_key", where: raw("(guest_id IS NOT NULL)"))
  @@unique([live_session_id, user_id], map: "live_likes_live_session_user_key", where: raw("(user_id IS NOT NULL)"))
  @@index([guest_id])
  @@index([live_session_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model live_comments {
  id              String      @id
  live_session_id String
  user_id         String?
  guest_id        String?
  username        String
  body            String
  created_at      DateTime    @default(now())
  live_sessions   LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           User?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([guest_id])
  @@index([live_session_id, created_at], map: "live_comments_live_session_created_at_idx")
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_follows {
  id                                     String   @id
  follower_id                            String
  following_id                           String
  created_at                             DateTime @default(now()) @db.Timestamptz(6)
  users_user_follows_follower_idTousers  User     @relation("user_follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_follows_follower_fk")
  users_user_follows_following_idTousers User     @relation("user_follows_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_follows_following_fk")

  @@unique([follower_id, following_id], map: "user_follows_unique")
  @@index([follower_id], map: "user_follows_follower_idx")
  @@index([following_id], map: "user_follows_following_idx")
}

enum LiveStatus {
  LIVE
  ENDED
}
